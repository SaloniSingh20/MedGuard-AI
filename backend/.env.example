# ── Backend environment variables ───────────────────────────────────────────
# Copy this file to .env and fill in the values.

# MongoDB connection string.
# • Local:   mongodb://127.0.0.1:27017/medguard
# • Atlas:   mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/medguard
MONGODB_URI=mongodb://127.0.0.1:27017/medguard

# Express server port (Railway auto-assigns PORT; this is the local fallback)
PORT=5000

# Frontend origin allowed by CORS
# • Local:  http://localhost:3000
# • Prod:   https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Ollama local LLM (not available on cloud — rule-based fallback runs automatically)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_MS=15000

# Python AI service (optional — separate pipeline tool, not used in main flow)
AI_SERVICE_URL=http://localhost:8000

# Blockchain (optional — leave CONTRACT_ADDRESS empty to disable)
CONTRACT_ADDRESS=
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Runtime environment
NODE_ENV=production

# Alert thresholds
ALERT_COUNTERFEIT_THRESHOLD=3
ALERT_SUSPICIOUS_THRESHOLD=2
ALERT_WINDOW_HOURS=24
